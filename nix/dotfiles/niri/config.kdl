spawn-at-startup "noctalia"

// BenQ GW2490 (PC monitor): 100 Hz
output "PNP(BNQ) BenQ GW2490 BBR0640101Q" {
    mode "1920x1080@100.000"
}

// Ask apps not to draw their own title bars (no app name bar at the top)
prefer-no-csd

window-rule {
    // Rounded corners for a modern look.
    geometry-corner-radius 20
    clip-to-geometry true
    // Transparent windows: no solid block behind them
    draw-border-with-background false
}

// Floating Noctalia settings window.
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

// Glass effect for terminals
window-rule {
    match app-id="^com\\.mitchellh\\.ghostty$"
    match app-id="^kitty$"

    background-effect {
        blur true
        saturation 1.3
        noise 0.03
    }
}

// Blur strength (raise offset for more frosted glass)
blur {
    passes 3
    offset 2.5
}

// Experimental: place the wallpaper in Niri's overview backdrop.
// Niri overview
overview {
    zoom 0.90

    workspace-shadow {
        off
    }
}

// Noctalia wallpaper layer
layer-rule {
    match namespace="^noctalia-wallpaper$"
    place-within-backdrop true
}


debug {
    // Allows notification actions and window activation from Noctalia.
    honor-xdg-activation-with-invalid-serial
}

binds {
    // Noctalia shell
    Mod+Space { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+S { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Comma { spawn-sh "noctalia msg settings-toggle"; }
    Alt+Tab { spawn-sh "noctalia msg window-switcher hold"; }
    Mod+V {spawn-sh "noctalia msg panel-toggle clipboard";}
    Mod+N { spawn-sh "noctalia msg panel-open control-center notifications"; }
    Mod+X { spawn-sh "noctalia msg panel-toggle session"; }
    Mod+W { spawn-sh "noctalia msg panel-toggle wallpaper"; }
    Mod+Shift+S { spawn-sh "noctalia msg screenshot-region"; }

    // Window management
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Q { close-window; }
    Mod+T { spawn-sh "ghostty"; }
    Mod+B { spawn "brave-origin"; }
    Mod+E { spawn "nautilus"; }
    Mod+Tab repeat=false { toggle-overview; }

    // Audio and brightness
    XF86AudioRaiseVolume { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute { spawn-sh "noctalia msg volume-mute"; }
    XF86MonBrightnessUp { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown { spawn-sh "noctalia msg brightness-down"; }

    // Switch to workspace
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    // Move only the focused window; stay on current workspace
    Mod+Ctrl+1 { move-window-to-workspace focus=false 1; }
    Mod+Ctrl+2 { move-window-to-workspace focus=false 2; }
    Mod+Ctrl+3 { move-window-to-workspace focus=false 3; }
    Mod+Ctrl+4 { move-window-to-workspace focus=false 4; }
    Mod+Ctrl+5 { move-window-to-workspace focus=false 5; }
    Mod+Ctrl+6 { move-window-to-workspace focus=false 6; }
    Mod+Ctrl+7 { move-window-to-workspace focus=false 7; }
    Mod+Ctrl+8 { move-window-to-workspace focus=false 8; }
    Mod+Ctrl+9 { move-window-to-workspace focus=false 9; }
    Mod+Ctrl+0 { move-window-to-workspace focus=false 10; }

    // Move the focused column to another workspace
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    // Focus columns and windows
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+K { focus-window-up; }
    Mod+J { focus-window-down; }

    // Move columns and windows
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+J { move-window-down; }

    // Move through workspaces
    Mod+I { focus-workspace-up; }
    Mod+U { focus-workspace-down; }

    // Center focused column
    Mod+C { center-column; }

    // Mod + mouse wheel: navigate app columns
    Mod+WheelScrollUp cooldown-ms=150 {
        focus-column-left;
    }
    Mod+WheelScrollDown cooldown-ms=150 {
        focus-column-right;
    }

    // Mod + Shift + mouse wheel: switch workspaces
    Mod+Shift+WheelScrollUp cooldown-ms=200 {
        focus-workspace-up;
    }
    Mod+Shift+WheelScrollDown cooldown-ms=200 {
        focus-workspace-down;
    }
}

input {
    touchpad {
        tap
        dwt
        natural-scroll
    }

    focus-follows-mouse
}

layout {
    background-color "transparent"

    // Active window highlight (only the focused window gets it, no default blue)
    focus-ring {
        width 2
        active-gradient from="#ffb38a" to="#ff6f91" angle=45
        inactive-color "#00000000"
    }
    border {
        off
    }
}

include "/home/chaotic_nylo/.config/niri-nix/cursor.kdl"
